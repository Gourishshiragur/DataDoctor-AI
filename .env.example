# Copy this file to .env and fill in what you have.
# Nothing here is required for Demo Mode — the app runs fully offline without any of these.

# ---- Databricks (Enterprise Mode) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CLUSTER_ID=

# ---- AI Providers (priority order: Ollama > Gemini > OpenRouter > OpenAI > Azure OpenAI > Claude) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_KEY=

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

def log_backend_event(run_id: str, layer: str, table_name: str, requested_backend: str,
                       actual_backend: str, fallback: bool, reason: str = ""):
    con = _conn()
    con.execute(
        "INSERT INTO backend_events (run_id, ts, layer, table_name, requested_backend, "
        "actual_backend, fallback, reason) VALUES (?,?,?,?,?,?,?,?)",

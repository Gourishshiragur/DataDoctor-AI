def get_notebook_version_content(version_id: str) -> Optional[str]:
    con = _conn()
    row = con.execute("SELECT content FROM notebook_versions WHERE version_id=?", (version_id,)).fetchone()
    con.close()
    return row[0] if row else None


def log_audit(actor: str, action: str, target: str, details: Optional[dict] = None) -> None:
    con = _conn()
    con.execute(
        "INSERT INTO audit_log (ts, actor, action, target, details) VALUES (?,?,?,?,?)",
        (time.time(), actor, action, target, json.dumps(details or {})),
    )
    con.commit()
    con.close()


def list_audit_log(limit: int = 200) -> list[dict]:
    con = _conn()
    rows = con.execute(
        "SELECT ts, actor, action, target, details FROM audit_log ORDER BY ts DESC LIMIT ?", (limit,),
    ).fetchall()
    con.close()
    out = []
    for ts, actor, action, target, details in rows:
        out.append({"ts": ts, "actor": actor, "action": action, "target": target,
                    "details": json.loads(details) if details else {}})
    return out

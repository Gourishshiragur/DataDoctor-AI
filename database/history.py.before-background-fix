"""
database/history.py
--------------------
Lightweight append-only history store for:
- pipeline run events (used by Monitor + Replay pages)
- lineage events (used by lineage graph on Dashboard/PipelineStudio)
- quality check results (used by Monitor)
- repair actions taken by the self-healing engine

Backed by SQLite (database/history.db) so it works with zero setup and survives restarts.
"""
from __future__ import annotations

import json
import sqlite3
import time
import uuid
from pathlib import Path
from typing import Any, Optional

ROOT_DIR = Path(__file__).resolve().parent.parent
DB_PATH = ROOT_DIR / "database" / "history.db"

SCHEMA = """
CREATE TABLE IF NOT EXISTS runs (
    run_id TEXT PRIMARY KEY,
    dataset TEXT,
    started_at REAL,
    finished_at REAL,
    status TEXT,
    summary TEXT
);
CREATE TABLE IF NOT EXISTS events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id TEXT,
    ts REAL,
    stage TEXT,
    level TEXT,
    message TEXT
);
CREATE TABLE IF NOT EXISTS lineage (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id TEXT,
    ts REAL,
    source_layer TEXT,
    source_table TEXT,
    target_layer TEXT,
    target_table TEXT,
    transform TEXT
);
CREATE TABLE IF NOT EXISTS quality_checks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id TEXT,
    ts REAL,
    check_name TEXT,
    layer TEXT,
    passed INTEGER,
    details TEXT
);
CREATE TABLE IF NOT EXISTS repairs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id TEXT,
    ts REAL,
    column_name TEXT,
    issue TEXT,
    action TEXT,
    rows_affected INTEGER,
    source TEXT
);
CREATE TABLE IF NOT EXISTS backend_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id TEXT,
    ts REAL,
    layer TEXT,
    table_name TEXT,
    requested_backend TEXT,
    actual_backend TEXT,
    fallback INTEGER,
    reason TEXT
);
CREATE TABLE IF NOT EXISTS datasets (
    dataset_id TEXT PRIMARY KEY,
    name TEXT,
    source TEXT,
    original_filename TEXT,
    file_path TEXT,
    row_count INTEGER,
    byte_size INTEGER,
    checksum TEXT,
    registered_at REAL
);
CREATE TABLE IF NOT EXISTS notebook_versions (
    version_id TEXT PRIMARY KEY,
    dataset_id TEXT,
    source_type TEXT,
    content TEXT,
    workspace_path TEXT,
    mode TEXT,
    deployed_at REAL,
    deployed_by TEXT
);
CREATE TABLE IF NOT EXISTS audit_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ts REAL,
    actor TEXT,
    action TEXT,
    target TEXT,
    details TEXT
);
"""


def _conn():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(DB_PATH))
    con.executescript(SCHEMA)
    return con


def new_run(dataset: str) -> str:
    run_id = str(uuid.uuid4())[:8]
    con = _conn()
    con.execute(
        "INSERT INTO runs (run_id, dataset, started_at, status, summary) VALUES (?,?,?,?,?)",
        (run_id, dataset, time.time(), "running", ""),
    )
    con.commit()
    con.close()
    return run_id



def update_run_summary(run_id: str, summary: dict):
    """Persist metadata while a pipeline is still running."""
    con = _conn()
    con.execute(
        "UPDATE runs SET summary=? WHERE run_id=?",
        (json.dumps(summary or {}), run_id),
    )
    con.commit()
    con.close()



def finish_run(run_id: str, status: str, summary: dict):
    con = _conn()
    con.execute(
        "UPDATE runs SET finished_at=?, status=?, summary=? WHERE run_id=?",
        (time.time(), status, json.dumps(summary), run_id),
    )
    con.commit()
    con.close()



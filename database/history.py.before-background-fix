def get_backend_events(run_id: Optional[str] = None, limit: int = 200):
    con = _conn()
    if run_id:
        rows = con.execute(
            "SELECT run_id, ts, layer, table_name, requested_backend, actual_backend, fallback, reason "
            "FROM backend_events WHERE run_id=? ORDER BY ts ASC", (run_id,),
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT run_id, ts, layer, table_name, requested_backend, actual_backend, fallback, reason "
            "FROM backend_events ORDER BY ts DESC LIMIT ?", (limit,),
        ).fetchall()
    con.close()
    cols = ["run_id", "ts", "layer", "table_name", "requested_backend", "actual_backend", "fallback", "reason"]
    out = [dict(zip(cols, r)) for r in rows]
    for d in out:
        d["fallback"] = bool(d["fallback"])
    return out



def reconcile_stale_runs(max_running_seconds: int = 900) -> int:
    """Close abandoned local runs so historical RUNNING does not mean active forever.

    A run is considered stale when it has remained in RUNNING state longer than
    the configured execution window without a finished_at timestamp.

    This is intentionally conservative: only old RUNNING records are changed.
    Recently started runs remain RUNNING.
    """
    cutoff = time.time() - max_running_seconds

    con = _conn()
    cur = con.execute(
        """
        UPDATE runs
        SET
            finished_at = ?,
            status = 'failed',
            summary = ?
        WHERE status = 'running'
          AND finished_at IS NULL
          AND started_at < ?
        """,
        (
            time.time(),
            json.dumps({
                "reason": "stale_run_reconciled",
                "message": (
                    "Execution did not report completion within the local "
                    "runtime reconciliation window."
                ),
            }),
            cutoff,
        ),
    )
    changed = cur.rowcount
    con.commit()
    con.close()

    return changed


def get_runs(limit: int = 50):
    con = _conn()
    rows = con.execute(
        "SELECT run_id, dataset, started_at, finished_at, status, summary FROM runs ORDER BY started_at DESC LIMIT ?",
        (limit,),
    ).fetchall()
    con.close()
    cols = ["run_id", "dataset", "started_at", "finished_at", "status", "summary"]
    return [dict(zip(cols, r)) for r in rows]


def get_run(run_id: str) -> Optional[dict]:
    con = _conn()
    row = con.execute(
        "SELECT run_id, dataset, started_at, finished_at, status, summary FROM runs WHERE run_id=?",
        (run_id,),
    ).fetchone()
    con.close()
    if not row:
        return None
    cols = ["run_id", "dataset", "started_at", "finished_at", "status", "summary"]
    return dict(zip(cols, row))


def get_events(run_id: str):
    con = _conn()
    rows = con.execute(
        "SELECT ts, stage, level, message FROM events WHERE run_id=? ORDER BY ts ASC", (run_id,)
    ).fetchall()
    con.close()
    return [dict(zip(["ts", "stage", "level", "message"], r)) for r in rows]


def get_lineage(run_id: Optional[str] = None):
    con = _conn()
    if run_id:
        rows = con.execute(
            "SELECT source_layer, source_table, target_layer, target_table, transform FROM lineage WHERE run_id=?",
            (run_id,),
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT source_layer, source_table, target_layer, target_table, transform FROM lineage ORDER BY ts DESC LIMIT 200"
        ).fetchall()
    con.close()
    cols = ["source_layer", "source_table", "target_layer", "target_table", "transform"]
    return [dict(zip(cols, r)) for r in rows]


def get_quality_checks(run_id: str):
    con = _conn()
    rows = con.execute(
        "SELECT check_name, layer, passed, details FROM quality_checks WHERE run_id=?", (run_id,)
    ).fetchall()
    con.close()
    out = []
    for r in rows:
        d = dict(zip(["check_name", "layer", "passed", "details"], r))
        d["passed"] = bool(d["passed"])
        d["details"] = json.loads(d["details"]) if d["details"] else {}
        out.append(d)
    return out


def get_repairs(run_id: Optional[str] = None):
    con = _conn()
    if run_id:
        rows = con.execute(
            "SELECT column_name, issue, action, rows_affected, source FROM repairs WHERE run_id=?", (run_id,)
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT column_name, issue, action, rows_affected, source FROM repairs ORDER BY ts DESC LIMIT 200"
        ).fetchall()
    con.close()
    cols = ["column_name", "issue", "action", "rows_affected", "source"]
    return [dict(zip(cols, r)) for r in rows]


# ---------------------------------------------------------------------------
# Storage Manager metadata — dataset registry, notebook version history, audit log.
# Phase 1 of the roadmap: uploads land here first (via storage/manager.py), and
# everything downstream (Databricks Volume upload, job submission) reads FROM this
# registry instead of re-serializing an in-memory DataFrame each time. This is what
# makes "rerun without re-upload" and "dataset history" possible.
# ---------------------------------------------------------------------------

def register_dataset(dataset_id: str, name: str, source: str, original_filename: str,
                      file_path: str, row_count: int, byte_size: int, checksum: str) -> None:
    con = _conn()
    con.execute(
        "INSERT INTO datasets (dataset_id, name, source, original_filename, file_path, "
        "row_count, byte_size, checksum, registered_at) VALUES (?,?,?,?,?,?,?,?,?)",
        (dataset_id, name, source, original_filename, file_path, row_count, byte_size, checksum, time.time()),
    )
    con.commit()
    con.close()


def get_dataset(dataset_id: str) -> Optional[dict]:
    con = _conn()
    row = con.execute(
        "SELECT dataset_id, name, source, original_filename, file_path, row_count, byte_size, "
        "checksum, registered_at FROM datasets WHERE dataset_id=?", (dataset_id,),
    ).fetchone()
    con.close()
    if not row:
        return None
    cols = ["dataset_id", "name", "source", "original_filename", "file_path", "row_count",
            "byte_size", "checksum", "registered_at"]
    return dict(zip(cols, row))


def list_datasets(limit: int = 50) -> list[dict]:
    con = _conn()
    rows = con.execute(
        "SELECT dataset_id, name, source, original_filename, file_path, row_count, byte_size, "
        "checksum, registered_at FROM datasets ORDER BY registered_at DESC LIMIT ?", (limit,),
    ).fetchall()
    con.close()
    cols = ["dataset_id", "name", "source", "original_filename", "file_path", "row_count",
            "byte_size", "checksum", "registered_at"]
    return [dict(zip(cols, r)) for r in rows]



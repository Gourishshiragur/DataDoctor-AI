"""Live enterprise pipeline visualization driven by runtime_state."""

from __future__ import annotations

import html
import textwrap

import streamlit as st

from pipeline import runtime_state


_STAGE_LABELS = {
    "source": "SOURCE",
    "bronze": "BRONZE",
    "profiling": "PROFILING",
    "quality": "QUALITY",
    "repair": "AI REPAIR",
    "silver": "SILVER",
    "gold": "GOLD",
}


def _stage_class(state: str) -> str:
    if state in {"running", "repairing", "retrying"}:
        return "running"
    if state == "success":
        return "success"
    if state == "failed":
        return "failed"
    if state == "cancelled":
        return "cancelled"
    return "waiting"


def _packet_count(info: dict) -> int:
    rows = info.get("rows_in") or info.get("rows_out") or 0

    if rows <= 0:
        return 3

    return max(3, min(7, int(rows / 1000) + 3))


def render(run_id: str | None = None):
    """Render actual pipeline state.

    Animation is tied to runtime state:
      running/repairing/retrying -> packets move
      success -> packets stop
      failed -> flow stops
      waiting -> no animation
    """

    run = runtime_state.get_run(run_id) if run_id else None

    if not run:
        st.markdown(
            textwrap.dedent("""
            <div class="dd-live-flow">
                <div class="dd-flow-header">
                    <div>
                        <div class="dd-flow-title">Live Pipeline Flow</div>
                        <div class="dd-flow-subtitle">
                            No active pipeline execution
                        </div>
                    </div>
                    <div class="dd-live-badge idle">? STANDBY</div>
                </div>
                <div class="dd-flow-empty">
                    Run a pipeline to observe actual stage execution.
                </div>
            </div>
            """).strip(),
            unsafe_allow_html=True,
        )
        return

    stages = run["stages"]

    active_stage = next(
        (
            stage
            for stage in runtime_state.STAGES
            if stages[stage]["state"]
            in {"running", "repairing", "retrying"}
        ),
        None,
    )

    status = str(run.get("status", "running")).upper()
    dataset = html.escape(str(run.get("dataset", "")))
    backend = html.escape(
        str(
            next(
                (
                    stages[s].get("backend")
                    for s in runtime_state.STAGES
                    if stages[s].get("backend")
                ),
                "configured backend",
            )
        )
    )

    cards = []

    for index, stage in enumerate(runtime_state.STAGES):
        info = stages[stage]
        state = info.get("state", "waiting")
        css = _stage_class(state)
        label = _STAGE_LABELS[stage]

        rows_in = int(info.get("rows_in") or 0)
        rows_out = int(info.get("rows_out") or 0)

        if rows_out:
            row_text = f"{rows_out:,} rows out"
        elif rows_in:
            row_text = f"{rows_in:,} rows in"
        else:
            row_text = "Awaiting data"

        message = html.escape(str(info.get("message") or ""))

        packets = ""

        if state in {"running", "repairing", "retrying"}:
            packet_count = _packet_count(info)

            packets = (
                '<div class="dd-packet-lane">'
                + "".join(
                    '<span class="dd-data-packet"></span>'
                    for _ in range(packet_count)
                )
                + "</div>"
            )

        cards.append(
            f"""
            <div class="dd-flow-stage {css}">
                <div class="dd-flow-stage-top">
                    <span class="dd-flow-stage-label">{label}</span>
                    <span class="dd-flow-state">{html.escape(state.upper())}</span>
                </div>

                {packets}

                <div class="dd-flow-stage-rows">
                    {row_text}
                </div>

                <div class="dd-flow-stage-message">
                    {message}
                </div>
            </div>
            """
        )

        if index < len(runtime_state.STAGES) - 1:
            next_stage = runtime_state.STAGES[index + 1]
            next_state = stages[next_stage]["state"]

            connection_active = (
                state == "success"
                and next_state in {"running", "repairing", "retrying"}
            )

            connection_failed = next_state == "failed"

            connection_class = ""

            if connection_active:
                connection_class = "active"
            elif connection_failed:
                connection_class = "failed"

            cards.append(
                f"""
                <div class="dd-flow-connector {connection_class}">
                    <span class="dd-connector-line"></span>
                    <span class="dd-connector-packet"></span>
                </div>
                """
            )

    if active_stage:
        badge = "? LIVE"
        badge_class = "live"
        active_label = _STAGE_LABELS[active_stage]
        subtitle = (
            f"{dataset} ? {active_label} executing ? "
            f"Backend: {backend}"
        )
    else:
        badge = f"? {status}"
        badge_class = status.lower()
        subtitle = f"{dataset} ? Backend: {backend}"

    metrics = run.get("metrics", {})

    quality = metrics.get("quality_score")
    repairs = metrics.get("repairs", 0)
    failed_checks = metrics.get("failed_checks", 0)

    quality_text = (
        f"{quality:.0f}/100"
        if isinstance(quality, (int, float))
        else "?"
    )

    st.markdown(
        f"""
        <style>
        .dd-live-flow {{
            margin: 18px 0 22px;
            padding: 20px;
            border-radius: 20px;
            border: 1px solid rgba(148,163,184,.18);
            background:
                linear-gradient(
                    135deg,
                    rgba(15,23,42,.98),
                    rgba(17,24,39,.95)
                );
            box-shadow: 0 12px 35px rgba(0,0,0,.16);
        }}

        .dd-flow-header {{
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 16px;
        }}

        .dd-flow-title {{
            color: #f1f5f9;
            font-size: 18px;
            font-weight: 750;
        }}

        .dd-flow-subtitle {{
            color: #94a3b8;
            font-size: 11px;
            margin-top: 4px;
        }}

        .dd-live-badge {{
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            white-space: nowrap;
        }}

        .dd-live-badge.live {{
            color: #60a5fa;
        }}

        .dd-live-badge.success {{
            color: #86efac;
        }}

        .dd-live-badge.failed {{
            color: #fca5a5;
        }}

        .dd-live-badge.idle {{
            color: #64748b;
        }}

        .dd-flow-track {{
            display: flex;
            align-items: center;
            gap: 5px;
            overflow-x: auto;
            padding: 4px 2px 10px;
        }}

        .dd-flow-stage {{
            position: relative;
            flex: 1 0 125px;
            min-height: 105px;
            padding: 12px;
            border-radius: 15px;
            border: 1px solid rgba(148,163,184,.14);
            background: rgba(30,41,59,.68);
            overflow: hidden;
        }}

        .dd-flow-stage.waiting {{
            opacity: .48;
        }}

        .dd-flow-stage.success {{
            border-color: rgba(74,222,128,.35);
        }}

        .dd-flow-stage.running {{
            border-color: rgba(96,165,250,.72);
            box-shadow: 0 0 25px rgba(59,130,246,.15);
        }}

        .dd-flow-stage.failed {{
            border-color: rgba(248,113,113,.65);
            background: rgba(127,29,29,.22);
        }}

        .dd-flow-stage.cancelled {{
            border-color: rgba(251,146,60,.5);
        }}

        .dd-flow-stage-top {{
            display: flex;
            justify-content: space-between;
            gap: 6px;
        }}

        .dd-flow-stage-label {{
            color: #cbd5e1;
            font-size: 9px;
            font-weight: 850;
            letter-spacing: .08em;
        }}

        .dd-flow-state {{
            color: #64748b;
            font-size: 8px;
            font-weight: 800;
        }}

        .running .dd-flow-state {{
            color: #93c5fd;
        }}

        .success .dd-flow-state {{
            color: #86efac;
        }}

        .failed .dd-flow-state {{
            color: #fca5a5;
        }}

        .dd-flow-stage-rows {{
            color: #e2e8f0;
            font-size: 12px;
            font-weight: 700;
            margin-top: 25px;
        }}

        .dd-flow-stage-message {{
            color: #64748b;
            font-size: 9px;
            margin-top: 5px;
            line-height: 1.3;
            max-height: 24px;
            overflow: hidden;
        }}

        .dd-flow-connector {{
            position: relative;
            flex: 0 0 34px;
            height: 26px;
            display: flex;
            align-items: center;
        }}

        .dd-connector-line {{
            width: 100%;
            height: 2px;
            background: #334155;
            border-radius: 4px;
        }}

        .dd-flow-connector.active .dd-connector-line {{
            background: #3b82f6;
            box-shadow: 0 0 8px rgba(59,130,246,.45);
        }}

        .dd-flow-connector.failed .dd-connector-line {{
            background: #ef4444;
        }}

        .dd-connector-packet {{
            position: absolute;
            left: -3px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #60a5fa;
            opacity: 0;
        }}

        .dd-flow-connector.active .dd-connector-packet {{
            opacity: 1;
            animation: dd-flow-packet 1.05s linear infinite;
        }}

        .dd-packet-lane {{
            position: absolute;
            left: 12px;
            right: 12px;
            top: 47px;
            height: 10px;
            pointer-events: none;
        }}

        .dd-data-packet {{
            position: absolute;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 8px rgba(96,165,250,.75);
            animation: dd-packet-travel 1.3s linear infinite;
        }}

        .dd-data-packet:nth-child(2) {{
            animation-delay: .22s;
        }}

        .dd-data-packet:nth-child(3) {{
            animation-delay: .44s;
        }}

        .dd-data-packet:nth-child(4) {{
            animation-delay: .66s;
        }}

        .dd-data-packet:nth-child(5) {{
            animation-delay: .88s;
        }}

        .dd-data-packet:nth-child(6) {{
            animation-delay: 1.1s;
        }}

        .dd-data-packet:nth-child(7) {{
            animation-delay: 1.32s;
        }}

        .dd-flow-metrics {{
            display: flex;
            gap: 8px;
            margin-top: 10px;
            flex-wrap: wrap;
        }}

        .dd-flow-metric {{
            padding: 7px 10px;
            border-radius: 9px;
            background: rgba(30,41,59,.62);
            color: #94a3b8;
            font-size: 10px;
        }}

        .dd-flow-metric b {{
            color: #e2e8f0;
        }}

        .dd-flow-empty {{
            color: #64748b;
            font-size: 12px;
            padding: 15px 2px 2px;
        }}

        @keyframes dd-packet-travel {{
            0% {{
                left: 0%;
                opacity: 0;
                transform: scale(.7);
            }}
            15% {{
                opacity: 1;
            }}
            75% {{
                opacity: 1;
            }}
            100% {{
                left: 96%;
                opacity: 0;
                transform: scale(1);
            }}
        }}

        @keyframes dd-flow-packet {{
            0% {{
                left: -2px;
                opacity: 0;
            }}
            15% {{
                opacity: 1;
            }}
            85% {{
                opacity: 1;
            }}
            100% {{
                left: calc(100% - 4px);
                opacity: 0;
            }}
        }}
        </style>

        <div class="dd-live-flow">
            <div class="dd-flow-header">
                <div>
                    <div class="dd-flow-title">Live Pipeline Flow</div>
                    <div class="dd-flow-subtitle">
                        {subtitle}
                    </div>
                </div>
                <div class="dd-live-badge {badge_class}">
                    {badge}
                </div>
            </div>

            <div class="dd-flow-track">
                {''.join(cards)}
            </div>

            <div class="dd-flow-metrics">
                <div class="dd-flow-metric">
                    Input <b>{int(metrics.get("rows_in") or 0):,}</b>
                </div>
                <div class="dd-flow-metric">
                    Output <b>{int(metrics.get("rows_out") or 0):,}</b>
                </div>
                <div class="dd-flow-metric">
                    Quality <b>{quality_text}</b>
                </div>
                <div class="dd-flow-metric">
                    Repairs <b>{int(repairs or 0):,}</b>
                </div>
                <div class="dd-flow-metric">
                    Failed checks <b>{int(failed_checks or 0):,}</b>
                </div>
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

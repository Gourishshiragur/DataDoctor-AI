"""ui/Dashboard.py — landing page: mode status, dataset overview, KPI cards, lineage graph,
recent run history at a glance."""
import pandas as pd
import plotly.express as px
import streamlit as st

from config.settings import current_mode, load_settings
from database import history
from pipeline import lineage
from storage import router as db


def render():
    st.title("📊 Dashboard")
    settings = load_settings()
    mode = current_mode(settings)

    col1, col2, col3, col4 = st.columns(4)
    runs = history.get_runs(limit=100)
    total_runs = len(runs)
    success_runs = len([r for r in runs if r["status"] == "success"])
    tables = db.list_tables("gold")

    with col1:
        st.metric("Mode", "Enterprise" if mode == "enterprise" else "Demo")
    with col2:
        st.metric("Pipeline Runs", total_runs)
    with col3:
        st.metric("Successful Runs", success_runs)
    with col4:
        st.metric("Gold Datasets", len(tables))

    recent_backend = history.get_backend_events(limit=1)
    if recent_backend:
        ev = recent_backend[0]
        if ev["fallback"]:
            st.warning(
                f"⚠️ Last storage operation fell back to **DuckDB** — Databricks was requested but "
                f"unavailable ({ev['reason']}).", icon="⚠️",
            )
        elif ev["actual_backend"] == "databricks":
            st.success("🟢 Last storage operation served live by **Databricks SQL Warehouse**.", icon="🟢")

    st.divider()

    if not runs:
        st.info("No pipeline runs yet. Head to **Pipeline Studio** to ingest a dataset and watch it self-heal live.")
        return

    left, right = st.columns([1.3, 1])

    with left:
        st.subheader("Recent Runs")
        df_runs = pd.DataFrame(runs)[["run_id", "dataset", "status", "started_at"]]
        df_runs["started_at"] = pd.to_datetime(df_runs["started_at"], unit="s")
        st.dataframe(df_runs, use_container_width=True, hide_index=True)

        st.subheader("Run Outcomes")
        status_counts = df_runs["status"].value_counts().reset_index()
        status_counts.columns = ["status", "count"]
        fig = px.bar(status_counts, x="status", y="count", color="status",
                     color_discrete_map={"success": "#2ecc71", "failed": "#e74c3c", "running": "#f39c12"})
        fig.update_layout(showlegend=False, height=300, margin=dict(l=10, r=10, t=10, b=10))
        st.plotly_chart(fig, use_container_width=True)

    with right:
        st.subheader("Pipeline Lineage")
        mermaid_code = lineage.build_mermaid()
        st.markdown(f"```mermaid\n{mermaid_code}\n```")
        st.caption("Bronze → Silver → Gold flow across all datasets processed so far.")

    st.divider()
    st.subheader("Gold Layer Datasets")
    if tables:
        for t in tables:
            with st.expander(f"📦 {t}"):
                try:
                    gdf = db.read_table("gold", t)
                    st.dataframe(gdf.head(20), use_container_width=True)
                except Exception as e:  # noqa: BLE001
                    st.warning(f"Could not load table: {e}")
    else:
        st.caption("No Gold tables materialized yet.")
